{
  "name": "mc-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-motion-lab.mjs",
    "build:motion-lab": "node scripts/build-motion-lab.mjs",
    "preview": "vite preview",
    "test": "vitest run src/App.test.jsx",
    "test:experiment": "node --test scripts/experiment-shell.test.mjs",
    "build:experiment": "bash scripts/build-experiment.sh",
    "test:handwritten-layout": "node scripts/check-handwritten-layout.mjs",
    "test:handwritten-owner-layout": "node scripts/check-handwritten-owner-alignment.mjs",
    "test:handwritten-final-polish": "node scripts/check-handwritten-final-polish.mjs",
    "test:final-ui-polish": "node scripts/check-final-ui-polish.mjs",
    "test:analytics-client": "node --test scripts/portfolio-analytics.test.mjs",
    "test:analytics-ui": "vitest run src/analyticsInstrumentation.test.jsx",
    "test:analytics-config": "node --test scripts/analytics-config.test.mjs",
    "security:check": "node scripts/security-check.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "30.1.1",
    "playwright": "^1.62.1",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  }
}
